# ---------------------------------------------------------------------------
# Yeoun Persona Engine — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Bearer token shared with Spring Boot for internal calls.
# Generate with: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
INTERNAL_TOKEN=replace-with-strong-random-token

# PostgreSQL DSN (asyncpg driver). Reached via WireGuard tunnel.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/yeoun

# Set to `true` to bypass PostgreSQL and use in-memory repository (dev/test).
USE_DB_MOCK=false

# Model weights directory — points at the `yeoun-models` Docker volume.
MODELS_DIR=/models

# Persistent persona assets (photo / voice / voice_ref / idle).
PERSONA_DIR=/var/persona

# Hugging Face cache directory (kept inside MODELS_DIR for volume reuse).
HF_HOME=/models/hf-cache

# Set to `false` to skip GPU model loading and return dummy outputs (dev/test).
GPU_ENABLED=true

# --- LLM 가중치 (이슈 #6) ---------------------------------------------------
# Gemma 4 BF16 가중치 디렉토리 또는 HF repo ID (예: `google/gemma-4-E4B-it`).
# transformers `from_pretrained` 가 HF repo ID 면 자동으로 다운로드·캐시한다.
# GPU_ENABLED=true 인데 비어 있으면 부팅 실패.
LLM_BF16_PATH=google/gemma-4-E4B-it

# --- TTS 가중치 (이슈 #7) ---------------------------------------------------
# OmniVoice TTS 가중치 디렉토리 또는 HF repo ID.
# GPU_ENABLED=true 인데 비어 있으면 TTS 로드 실패.
TTS_MODEL_PATH=k2-fsa/OmniVoice

# --- Ditto-TalkingHead (이슈 #8) --------------------------------------------
# README: https://huggingface.co/digital-avatar/ditto-talkinghead
#   1) git clone github.com/antgroup/ditto-talkinghead  → DITTO_VENDOR_DIR
#   2) cd $DITTO_VENDOR_DIR && git clone hf.co/digital-avatar/ditto-talkinghead checkpoints
# 본 엔진은 `python <vendor>/inference.py ...` CLI 를 subprocess 로 호출한다.
DITTO_VENDOR_DIR=./vendor/ditto-talkinghead
# README 디폴트(Ampere/Ada 호환). Blackwell sm_120 환경에선 ditto_pytorch 로 변경 또는 #15 재변환.
DITTO_DATA_ROOT=./vendor/ditto-talkinghead/checkpoints/ditto_trt_Ampere_Plus
# TRT 백엔드는 `_trt.pkl`, PyTorch 백엔드는 `_pytorch.pkl`.
DITTO_CFG_PKL=./vendor/ditto-talkinghead/checkpoints/ditto_cfg/v0.4_hubert_cfg_trt.pkl

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
