# ---------------------------------------------------------------------------
# Yeoun Persona Engine — 환경 변수 템플릿
# 본 파일을 `.env` 로 복사한 뒤 실제 값으로 채운다. `.env` 는 git-ignored.
# ---------------------------------------------------------------------------

# Spring Boot 와 공유하는 내부 호출 Bearer 토큰.
# 생성: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
INTERNAL_TOKEN=replace-with-strong-random-token

# PostgreSQL DSN (asyncpg driver). WireGuard 터널 경유.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/yeoun

# `true` 면 PostgreSQL 우회·인메모리 mock repository 사용 (개발·테스트).
USE_DB_MOCK=false

# 모델 가중치 디렉토리 — `yeoun-models` 도커 볼륨 마운트 경로.
MODELS_DIR=/models

# 페르소나 영구 자원 (photo / voice / voice_ref / idle).
PERSONA_DIR=/var/persona

# HuggingFace 캐시 디렉토리. `MODELS_DIR` 볼륨 재사용을 위해 하위에 배치.
HF_HOME=/models/hf-cache

# `false` 면 모델 로더가 더미 모드로 동작해 placeholder 응답 반환 (개발·테스트).
GPU_ENABLED=true

# --- LLM 가중치 (이슈 #6) ---------------------------------------------------
# Gemma 4 BF16 가중치 디렉토리 또는 HF repo ID (예: `google/gemma-4-E4B-it`).
# transformers `from_pretrained` 가 HF repo ID 면 자동으로 다운로드·캐시한다.
# GPU_ENABLED=true 인데 비어 있으면 부팅 실패.
LLM_BF16_PATH=google/gemma-4-E4B-it

# --- TTS 가중치 (이슈 #7) ---------------------------------------------------
# OmniVoice TTS 가중치 디렉토리 또는 HF repo ID.
# GPU_ENABLED=true 인데 비어 있으면 TTS 로드 실패.
TTS_MODEL_PATH=k2-fsa/OmniVoice

# --- Ditto-TalkingHead (이슈 #8) --------------------------------------------
# README: https://huggingface.co/digital-avatar/ditto-talkinghead
#   1) git clone github.com/antgroup/ditto-talkinghead  → DITTO_VENDOR_DIR
#   2) cd $DITTO_VENDOR_DIR && git clone hf.co/digital-avatar/ditto-talkinghead checkpoints
# 본 엔진은 `python <vendor>/inference.py ...` CLI 를 subprocess 로 호출한다.
DITTO_VENDOR_DIR=./vendor/ditto-talkinghead
# 기본값은 PyTorch 백엔드 — Blackwell(sm_120) 은 vendor 가 빌드해 둔 TensorRT 8.6.1
# 엔진과 호환되지 않으므로 ditto_pytorch + _pytorch.pkl 조합 사용. Ampere/Ada 인스턴스
# 에서는 TRT 백엔드(아래 주석) 가 더 빠르다.
DITTO_DATA_ROOT=./vendor/ditto-talkinghead/checkpoints/ditto_pytorch
DITTO_CFG_PKL=./vendor/ditto-talkinghead/checkpoints/ditto_cfg/v0.4_hubert_cfg_pytorch.pkl
# TRT 백엔드(Ampere/Ada 전용) 사용 시 위 두 줄 대신 아래 두 줄을 활성화하고
# `pip install tensorrt pycuda` 를 추가로 수행:
#   DITTO_DATA_ROOT=./vendor/ditto-talkinghead/checkpoints/ditto_trt_Ampere_Plus
#   DITTO_CFG_PKL=./vendor/ditto-talkinghead/checkpoints/ditto_cfg/v0.4_hubert_cfg_trt.pkl

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
